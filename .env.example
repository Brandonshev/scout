# Copy this file to .env and fill in values. .env is git-ignored — never share it.
#
# iMessage recipient (v0.8.0): your iPhone's number in international format, or your Apple ID email.
# SCOUT_NOTIFY__IMESSAGE_RECIPIENT="+614XXXXXXXX"
#
# ntfy push alerts (v0.11.0): a long random topic; `uv run scout ntfy-setup` creates it for you.
# SCOUT_NOTIFY__NTFY_TOPIC="scout-xxxx-xxxx-xxxx-xxxx"
#
# Any setting in config.yaml can also be overridden here, using SCOUT_ + section + __ + key:
#   SCOUT_RISK__RISK_PER_TRADE_PCT=0.5
